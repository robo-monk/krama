# what elements can be part of arrays
set SizedElementRequirements = (
	.@mem_size -> u32
)
shape Sized(x: @implements(SizedElementRequirements));

shape Sized(x: @implements(
	.mem_size -> u32
));



shape Vector(x: Sized) {
	mut capacity = 0
	mut idx = 0
	let el_size = x.size
}

target Vector(@el_type) {
	mutation push(other: @el_type) {
		# implementation details
	}

	function at(idx: u32) -> @el_type {
		# implementation details
	}
}

let vec = Vector(u32)
vec.push(4)

# ---

set NumberRequirements = (
	~add(x: Number) -> void,
	~sub(x: Number) -> void,
	~mul(x: Number) -> void,
	~div(x: Number) -> void,
	:to_string() -> String,
)

target @with(NumberRequirements) {
	mutation pow(exp: Natural) {
		mut i = 0
		while i < exp {
			self.value *= self.value
			i++
		}
	}
}

set BinOp = (
	ADD, 
	MUL,
	DIV, 
	SUB
)

shape BinOpStatement(type: BinOp) {}

set LiteralType = (u8, u16, u32, u64, usize)
shape SymbolStatement(type: LiteralType) {
	let name: string
}

shape BlockStatement {
	let args: Vector(Statement)
	let statements: Vector(Statement)
}

shape ConditionalStatement {
	let condition: Statement
	let if_body: BlockStatement
	let else_body: BlockStatement
}

set StatementType = (
	BinOpStatement,
	SymbolStatement,
	BlockStatement,
	ConditionalStatement
)

shape Statement(type: StatementType) {
	let token: Token

	mut lhs: Statement?
	mut rhs: Statement?
}

target Statement(type: StatementType) {
}

target Statement(@stmt_type) {
	mutation compile(com: Compiler): void {
		println("not implement for {@stmt_type}")
	}
}

target Statement(StatementType.BlockStatement) {
	mutation compile(com: Compiler): void {}
}

target Statement(StatementType.BinaryOp) {
	mutation compile(com: Compiler): void {
		return void if !self.rhs?
	}
}

shape CompilerScope {
	mut headers: string
 	mut declerations: string
	mut implementations: string
 	mut upper_scope: CompilerScope?
	let symbols: HashMap
}

shape Compiler {
	scope: CompilerScope
}




target |com: Compiler| {
	mutation compile_statement(Statement stmt) {
		com.current_stmt = stmt;

		match stmt.type {
			StatementType.Block -> 		com~compile_block_statement(stmt),
			StatementType.Tree -> 		com~compile_tree_statement(stmt),
			StatementType.BinaryOp -> com~compile_bin_op_statement(stmt),
		}
	}
}




shape Tokeniser(tokens: Token[]) {
	let tokens = tokens
	mut position = @array_index(tokens)
 	mut current_token = @derived(tokens[position])
}

target |t: Tokeniser| {
	function peek() {
		t.tokens:at(t.current_index)
	}

	function look_ahead(): Token? {
		return None if t.current_index + 1 >= tokens.length 
		return t.tokens:at(t.current_index + 1)
	}

	mutation eat() {
		t.position += 1
	}
}

protocol Sort {
	mutation sort(): void
}

target Sort::QuickSort {
}

target QuickSort(mut arr: Array) implements Sort {
	mutation partition() {
		let pivot_index = arr.length - 1
		let pivot = arr[pivot_index]
		mut i = 0

		for j in 0..pivot_index {
			if arr[j] <= pivot {
				arr~swap(i, j)
				i += 1
			}
		}
	}

 	mutation quick_sort() {
		return void if a.len <= 1
		let pivot_index = a~partition()
	}
}

