fn malloc(i64 size) {
    return @malloc(size) as any
}

fn new(char* _, i64 size) {
    return malloc(size) as char*
}

fn free(char* s) {
    @raw_c("free(s)")
}

fn println(char* fmt, char* s) {
    @raw_c("printf(fmt, s)");
    @raw_c("printf(\"\n\")");
}

fn println(char* s) {
    println("%s", s)
}

fn add(@T gen1, @T gen2) {
    return @raw_c("gen1 + gen2") as @T;
}

fn add(char* a, char* b) {
    let len_a = @raw_c("strlen(a)") as i64;
    let len_b = @raw_c("strlen(b)") as i64;
    let result = malloc(50) as char*
    @raw_c("strcpy(result, a)")
    @raw_c("strcat(result, b)")
    return result
}

fn main() {
    let bing = malloc(5)
    let String = ""
    let foo = String:new(12)
    foo:free


    let bong = 5 + 4
    let hello_world = "hello" + " " + "world"
    hello_world:println
    return 0 as i32
}
