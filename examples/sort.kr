atom u64 = U64
atom Day = MON | TUE | WED | THU | FRI | SAT | SUN

def id(Player &p) {}


type Player {
    i64 id,
    string name
}

fn &Player new(Player, i64 id) {
    let p = @malloc(@sizeof(Player.id) + @sizeof(Player.name))
    return p
}

fn i64 id(Player p) {
    p
}

let p = Player:new(302)
p:id:set(590)
